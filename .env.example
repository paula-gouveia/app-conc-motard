# .env.example — Copia este ficheiro para .env e preenche os valores.
#
# O ficheiro .env NÃO deve ser committed para o Git (já está no .gitignore).
# É usado pelo db/import.py em desenvolvimento local.
# Em produção (GitHub Actions), configura os mesmos valores como Secrets:
#   Repositório → Settings → Secrets and variables → Actions
#
# ONDE ENCONTRAR OS VALORES:
#   No dashboard do Supabase: Settings → API
#   - Project URL           → SUPABASE_URL
#   - service_role (secret) → SUPABASE_SERVICE_KEY  ← não partilhar!
#   - anon (public)         → SUPABASE_ANON_KEY     ← usado pelo frontend

# URL do projecto Supabase
SUPABASE_URL=https://<projecto>.supabase.co

# Chave service_role — permite escrita na BD, bypassa o RLS.
# Usar APENAS no scraper/import. NUNCA expor no frontend ou em código público.
SUPABASE_SERVICE_KEY=<service_role_key>

# Chave anon — leitura pública. Pode ser exposta no frontend.
# (Não é usada pelo scraper — guardada aqui para referência da Fase frontend)
SUPABASE_ANON_KEY=<anon_key>

# Opcional: desactivar verificação SSL em ambiente de teste com proxy
# SCRAPER_SSL_VERIFY=0
